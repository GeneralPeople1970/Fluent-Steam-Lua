<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- 浮层阴影：仅用于菜单面板 / 遮罩卡片 / FAB，静态卡片保持平面 -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3"/>
    <DropShadowEffect x:Key="FabShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.32"/>

    <!-- Home 卡片细节色：深色打底保证白色图标两主题可读 -->
    <SolidColorBrush x:Key="CardRefreshButtonFill" Color="#AA000000"/>
    <SolidColorBrush x:Key="CardDisabledOverlayFill" Color="#60000000"/>

    <!-- 设置卡片：统一圆角 10 + 0.45 半透明背景 -->
    <Style x:Key="SettingsCardStyle" TargetType="{x:Type ui:SettingsCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InfoBar 统一外观：透明无边框（旧版观感），仅统一圆角与文本色 -->
    <Style x:Key="InfoBarStyle" TargetType="{x:Type ui:InfoBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Severity" Value="Informational"/>
        <Setter Property="IsClosable" Value="False"/>
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- 日志行：英文等宽 + 中文雅黑，行距舒适，主色高对比 -->
    <Style x:Key="LogTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="LogEmptyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,32,0,32"/>
    </Style>

</ResourceDictionary>